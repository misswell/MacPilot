<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.misswell.macpilot.display-recovery</string>
	<!--
	  The program lives in a nested app bundle (Contents/Helpers/
	  MacPilotDisplayRecovery.app), not directly under Contents/MacOS. A bare
	  executable there inherits the host bundle's identity, and LaunchServices
	  then treats a running agent as a running MacPilot — `open -a MacPilot.app`,
	  Finder double-clicks and login launches resolve to the agent, so the real
	  process never starts and nothing appears. The nested bundle gives the
	  agent its own identity while keeping the program inside the host bundle,
	  which SMAppService requires.
	-->
	<key>BundleProgram</key>
	<string>Contents/Helpers/MacPilotDisplayRecovery.app/Contents/MacOS/MacPilotDisplayRecovery</string>
	<key>MachServices</key>
	<dict>
		<key>com.misswell.macpilot.display-recovery</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
