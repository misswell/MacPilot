{
  "schema_version": 1,
  "description": "MacPilot 防回归统一索引：AI 修改前检查、本地回归选择器与 CI 门禁共用这一份数据。改这里即同时改三处行为，不允许在 CI 或文档里另维护一份测试清单。",
  "scope_note": "status 取值：confirmed-recurring（有 >=2 个修复提交指向同一根因，已实际复发）、confirmed-potential（根因已确认存在但尚未二次触发的高危隐患）、unverified（线索存在但提交证据不足，只记录不作为门禁依据）。",
  "full_suite": {
    "description": "源码修改未命中任何规则时的回退集合 = 所有规则的 test_filters 并集 + 此处列出的安全基础套件。完整含义见 docs/engineering/README.md。",
    "baseline_extra_filters": [
      "Awake", "AwakeAssertionControllerTests", "AwakePolicyEngineTests",
      "Clipboard", "SecondarySelectionRegressionTests",
      "ScreenRecordingTests", "ScreenRecordingPermissionWatcherTests", "CaptureEnhancementsTests",
      "RemoteControlAppStoreInfoTests", "RemoteNavigationControlTests", "MouseInjectorEventTests", "RemoteInputCoordinatorTests",
      "RemoteTextInputTests", "RemoteMediaControlTests", "RemoteVideoEncoderTests",
      "RemoteVideoTransportTests", "RemoteBonjourPublisherTests", "LocalNetworkSessionDiagnosisTests",
      "ScreenCaptureTests", "ScreenCaptureClipboardRegressionTests", "SnapzyCaptureTests",
      "SmoothScrolling", "SmoothScrollRecoveryTests", "SmoothScrollRuntimeTests",
      "LocalPortsModelTests", "LocalPortCloseServiceTests", "LocalPortsIconTests", "LocalPortsLocalizationTests",
      "InputSourceTests", "InputSourceSwitchTests", "InputSourceSwitchEvidenceTests",
      "PictureInPictureTests", "QuickAccessTests", "GracefulQuitTests",
      "LaunchRuleCodingTests", "LoginItemPolicyTests", "ScreenLockHistoryTests",
      "ThumbnailCacheTests", "ProcessIconStoreTests", "ImageHostingTests",
      "FileCompressionTests", "FileCompressionMonitoringTests", "DiagnosticLogTests",
      "HomeSwitchAlignmentTests", "FeatureSelectionTests", "KeychainSnapshotTests",
      "PreferenceSnapshotTests", "ConfigurationSnapshotTests"
    ],
    "package_suites": [
      {
        "package_path": "Packages/MacPilotRemoteProtocol",
        "filter": "ProximityGATT|ReversePresence"
      }
    ],
    "extra_commands": [
      "python3 Tests/Release/stapler-retry-tests.py"
    ]
  },
  "flaky_waiver_policy": "只有列在此处、且**单独重跑通过**的测试才允许被豁免；豁免会打印为 WAIVED 并计入报告。未列入此清单的失败一律是门禁失败，绝不因为「以前也这样」放行。豁免依据是 AGENTS.md 记录的同族问题：断言依赖真实墙钟时间，全套运行时前一个套件会占住 main actor 数十秒（隔离 0.060s vs 全套 3.982s）。这不是降低测试标准——断言与阈值都不改，只要求在隔离环境下复核。",
  "known_flaky_tests": [
    "CPUMonitorTests.samplerReportsAFullyBusyCoreAtItsRealShare",
    "BLEWakeRecoveryTests.overdueSignalTimeoutClearsThePreSleepPresence",
    "ScreenCaptureTests.startupShortcutRegistrationRetriesTransientFailure",
    "ScreenCaptureTests.quickCopyAutoSaveWritesFileAndRecordsStats",
    "SnapzySingleFrameCaptureTests.timeoutEndsAStalledCapture",
    "RemoteVideoTransportTests.independentVideoSocketAuthenticatesAndRejectsAQueuedFrameBacklog",
    "PictureInPictureTests.stalledCaptureStateAppearsAfterMotionStopsAndClearsOnChange",
    "MenuBarDisplayControllerTests.topologyChangeWhileAMenuTracksDuringTheRemovedWindowRestoresTheItem",
    "QuickSearchIconLoaderTests.aFailedIconIsRetriedOnceThePanelReopens"
  ],
  "modules": [
    {
      "id": "window-lifecycle",
      "name": "主窗口与 AppKit 生命周期",
      "doc": "docs/engineering/regressions/window-lifecycle.md",
      "rules": [
        {
          "id": "win-001-main-window-opener",
          "module": "window-lifecycle",
          "title": "菜单/Dock 打不开主窗口：opener 生命周期与 pendingRequest 死路",
          "status": "confirmed-recurring",
          "risk_level": "critical",
          "affected_paths": [
            "Sources/MacPilot/MainWindowScene.swift",
            "Sources/MacPilot/MacPilotApp.swift",
            "Sources/MacPilot/Core/**"
          ],
          "invariants": [
            "窗口内容立即加载、下一 run-loop turn 才抬窗；菜单跟踪循环内不得同步 orderFront。",
            "激活被拒绝时仍必须 orderFrontRegardless 留下可见窗口；LSUIElement 进程禁止用 NSRunningApplication.activate 抬窗。",
            "找不到可用窗口的请求必须走 openWindow(id: \"main\")，禁止无人 drain 的 pendingRequest 标志。",
            "每次打开结果写入 DiagnosticLog 的 MainWindow 通道。"
          ],
          "test_filters": [
            "MainWindowOpenerTests",
            "MainWindowContentStateTests",
            "WindowFocusServiceTests",
            "WindowSwitcherTests",
            "AppLifecycleTests"
          ],
          "extra_test_commands": [],
          "manual_checks": [
            "关闭主窗口后分别从菜单「设置」、Dock 图标、Finder 深链重新打开，连续关闭重开多次。",
            "macOS 拒绝前台激活时窗口仍可见（orderFrontRegardless 路径）。"
          ],
          "evidence_commits": [
            { "sha": "5ecdb66", "date": "2026-09-28", "subject": "load main window content when raised outside the app" },
            { "sha": "8d8daa6", "date": "2026-10-29", "subject": "retain main window opener after closing（同日被 revert）" },
            { "sha": "9d71f61", "date": "2026-10-29", "subject": "Revert \"retain main window opener after closing\"" },
            { "sha": "42453ac", "date": "2026-10-29", "subject": "retain the main window opener for the application lifetime" },
            { "sha": "d080766", "date": "2026-10-30", "subject": "keep the settings menu able to open the main window（当时误判根因在 opener 侧）" },
            { "sha": "dc224ff", "date": "2026-10-31", "subject": "release the menu snapshot after AppKit dispatches the action（真正根因在菜单侧，见 menu-002）" }
          ]
        }
      ]
    },
    {
