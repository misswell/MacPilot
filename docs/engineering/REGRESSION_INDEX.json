        {
          "id": "menu-002-session-release-vs-action-dispatch",
          "module": "menu-bar-lifecycle",
          "title": "menuDidClose 同步释放 session 导致所有菜单动作静默失效（修复A引发B）",
          "status": "confirmed-recurring",
          "risk_level": "critical",
          "affected_paths": [
            "Sources/MacPilot/MenuBarDisplayController.swift",
            "Sources/MacPilot/MenuBarMenuSession.swift"
          ],
          "invariants": [
            "menuDidClose 不得同步释放菜单 session：macOS 27 在 menuDidClose 之后同一 run-loop turn 才派发所选动作，NSMenuItem 持弱引用 target。",
            "controller 在 menuDidClose 停止持有 session，捕获的引用延后一个 main-queue turn 再释放。"
          ],
          "test_filters": [
            "MenuBarOwnedMenuTests",
            "MenuBarDisplayControllerTests",
            "MenuBarMenuSessionTests"
          ],
          "extra_test_commands": [],
          "manual_checks": [
            "真实 AppKit 菜单：打开菜单点「设置 / 显示器 / 快速搜索 / 退出」各项都必须执行；这是模拟测试无法完全替代的分发链路。"
          ],
          "evidence_commits": [
            { "sha": "591ecd0", "date": "2026-10-30", "subject": "let AppKit place the status item menu（引入 menuDidClose 立即 drop session）" },
            { "sha": "dc224ff", "date": "2026-10-31", "subject": "release the menu snapshot after AppKit dispatches the action（承认 d080766 误判）" }
